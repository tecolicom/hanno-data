#!/usr/bin/env python3
"""calendar/tests/run-golden — クローラ出力をバイト一致でロックする回帰テスト。

各クローラを fixtures (calendar/tests/fixtures/<crawler>/) を入力に hermetic 実行し、
生成 YAML を日付正規化して golden/<crawler>/ と比較する。ネットワーク不使用。

  python3 calendar/tests/run-golden           # 比較 (一致=exit0, 不一致=exit1)
  python3 calendar/tests/run-golden --update  # golden 再生成 (初回/意図的変更時)

dtstart/dtend/fetched_at は incremental では実行日に依存するので、比較前に
プレースホルダへ正規化する。content_hash は日付非依存 (canonical に dtstart を
含めない設計) なので正規化せず、ハッシュ回帰はそのまま検知される。
"""
from __future__ import annotations
import importlib.machinery, importlib.util, glob, json, os, re, shutil, sys, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
BIN = os.path.normpath(os.path.join(HERE, "..", "bin"))
FIX = os.path.join(HERE, "fixtures")
GOLD = os.path.join(HERE, "golden")
SEED = os.path.join(HERE, "seed")


def _load(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"),
                                                  os.path.join(BIN, name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec); loader.exec_module(mod)
    return mod


def _manifest(crawler):
    with open(os.path.join(FIX, crawler, "manifest.json"), encoding="utf-8") as f:
        return json.load(f)


def _read_fixture(crawler, fname):
    with open(os.path.join(FIX, crawler, fname), encoding="utf-8") as f:
        return f.read()


# dtstart が実行日に依存しないクローラ。ここに載るものは日付を正規化せず
# そのまま比較する。news は「本文から抽出した開催日」が dtstart なので、
# 潰すと本設計の要である日付抽出の回帰を golden が見逃す。
DETERMINISTIC_DATE_CRAWLERS = {"cal-tourism-news-fetch", "cal-cci-chef-fetch",
                               "cal-cci-event-fetch", "cal-lib-closed-fetch",
                               "cal-lib-event-fetch"}

# --today を渡すクローラと、その基準日。固定しないと fixture 内の予定が日々
# 「過去」に流れ、削除の可否や取得ウィンドウが変わって golden が壊れる。
# 図書館クローラは取得ウィンドウ (cal.php の term_from/term_to) も today から
# 作るので、fixture の URL と一致する日付を選ぶこと。
TODAY_BY_CRAWLER = {
    "cal-cci-chef-fetch": "2026-06-01",
    "cal-lib-closed-fetch": "2026-08-24",
    "cal-lib-event-fetch": "2026-08-24",
}


def _normalize(text, keep_dates=False):
    if not keep_dates:
        text = re.sub(r'^(dtstart: ).*$', r'\1"<DATE>"', text, flags=re.M)
        text = re.sub(r'^(dtend: ).*$', r'\1"<DATE>"', text, flags=re.M)
    text = re.sub(r'^(  fetched_at: ).*$', r'\1"<TS>"', text, flags=re.M)
    return text


def _golden_key(path, keep_date=False):
    # <out>/<YYYY>/<MM-DD>_<uidlocal>.yaml → <uidlocal>.yaml
    # keep_date=True では MM-DD を残す (どの日に置かれたかも回帰対象にする)。
    base = os.path.basename(path)
    return base if keep_date else re.sub(r'^\d\d-\d\d_', '', base)


# fixture 記事の Last-Modified 固定値。JST 2026-06-12 → dtstart = +1 日 = 2026-06-13。
# golden 捕捉時の実サーバ値と一致するので、golden はそのまま維持される。
OSHIRASE_FIXED_LM = "Fri, 12 Jun 2026 09:00:00 GMT"


def _setup_oshirase(m, crawler, manifest):
    m._llm_available = lambda: False  # LLM 経路を断つ (deterministic)
    # 記事本文は fetch_with_cache 経由なので、こちらもモックしないと実ネットワークに出る
    m.fetch_with_cache = lambda url, etag, lm: (
        (_read_fixture(crawler, manifest[url]), None, OSHIRASE_FIXED_LM) if url in manifest
        else (None, None, None)  # manifest 外の URL は 304 = skip
    )
    m.load_http_cache = lambda: {}
    m.save_http_cache = lambda c: None


def _setup_shicho_blog(m, crawler, manifest):
    m.fetch_with_cache = lambda url, etag, lm: (
        (_read_fixture(crawler, manifest[url]), None, None) if url in manifest
        else (None, None, None)  # 未捕捉の月は 304 = skip
    )
    m.load_http_cache = lambda: {}
    m.save_http_cache = lambda c: None


def _setup_tourism_news(m, crawler, manifest):
    """API レスポンスと LLM 応答を fixtures から再生する。

    LLM は非決定的なので実呼び出しはしない (記録済み応答の再生)。
    """
    with open(os.path.join(FIX, crawler, "api-page1.json"), encoding="utf-8") as f:
        posts = json.load(f)
    with open(os.path.join(FIX, crawler, "llm.json"), encoding="utf-8") as f:
        replies = json.load(f)

    def _fetch_json(url):
        # 1 ページ目だけ返し、2 ページ目以降は空 (= 打ち切り)
        return posts if "&page=1&" in url or "&page=1" in url else []
    m.fetch_json = _fetch_json

    # user プロンプト中の "# タイトル" 行から記事を引き当てて応答を返す。
    # 先頭行ではなく該当行を探す (冒頭に "記事公開日: …" が付くため)。
    by_title = {(p.get("title") or {}).get("rendered", ""): str(p["id"])
                for p in posts}

    def _call_llm(system, user, **kw):
        for line in user.split("\n"):
            if line.startswith("# "):
                return replies.get(by_title.get(line[2:].strip(), ""))
        return None
    m.call_llm = _call_llm

    m.load_http_cache = lambda: {}
    m.save_http_cache = lambda c: None
    # backfill フィルタが「今日」に依存すると golden が日々壊れるので実質無効化する
    m.DEFAULT_BACKFILL_MONTHS = 12000
    # fixtures は数件しか無いので --min-news の下限チェックを無効化する
    # (run-golden は sys.argv を組み立てるため CLI 引数を足せない)
    m.check_news_count = lambda n, min_news: None


def _setup_cci_event(m, crawler, manifest):
    """RSS 取得を fixture に差し替え、LLM 経路を断つ (追記型)。

    **fetch_posts ではなく fetch_feed を差し替える。** こうすると golden が
    RSS のパース経路 (parse_feed / merge_posts) まで通る。fetch_posts ごと
    置き換えると、本番に存在しない経路をテストすることになる。

    _llm_available() を False にすると長文も method=full になり、差分行も
    None になって決定論化する。content_hash に method を含めない設計なので
    hash は動かない。差分行の生成そのものは非決定的なので golden では見ない
    (drop_unchanged_claims の挙動は tests/test_diff_verify.py が見ている)。
    """
    def _fetch_feed(url):
        if url not in manifest:
            raise RuntimeError(f"fixture 外の URL: {url}")
        return _read_fixture(crawler, manifest[url])
    m.fetch_feed = _fetch_feed
    m._llm_available = lambda: False


def _setup_cci_chef(m, crawler, manifest):
    """HTTP を fixture に差し替える (集合同期型クローラ)。

    基準日の固定は TODAY_BY_CRAWLER を --today で渡すことで行う (_run_crawler)。
    """
    m.fetch_with_cache = lambda url, etag, lm: (
        (_read_fixture(crawler, manifest[url]), None, None) if url in manifest
        else (None, None, None))
    m.load_http_cache = lambda: {}
    m.save_http_cache = lambda c: None


def _setup_lib(m, crawler, manifest):
    """URL → テキストの層だけ fixture に差し替える (最下層).

    _hanno_lib.fetch_text を潰すので、JSON 解析 (terms_of / days_of) も
    items 生成も本物が走る。上位を差し替えると今回書いた解析コードが 1 行も
    走らないまま緑になる。
    """
    sys.path.insert(0, BIN)
    import _hanno_lib

    # クローラが fetch_text を from-import していると、モジュールの名前空間に
    # 束縛がコピーされて下の差し替えが効かず、golden が実ネットワークに出る
    # (手元では非決定的、CI では URLError)。静かに漏れるくらいならその場で
    # 落とす。_hanno_lib.fetch_text(...) と修飾して呼ぶこと。
    assert not hasattr(m, "fetch_text"), (
        f"{crawler} が fetch_text を from-import している。"
        "_hanno_lib.fetch_text(...) と修飾して呼ぶこと "
        "(_hanno_lib.fetch_text の docstring 参照)")

    def _fetch_text(url):
        if url not in manifest:
            raise RuntimeError(f"fixture 外の URL: {url}")
        return _read_fixture(crawler, manifest[url])

    _hanno_lib.fetch_text = _fetch_text
    m.fetch_with_cache = lambda url, etag, lm: (
        (_read_fixture(crawler, manifest[url]), None, None) if url in manifest
        else (None, None, None))
    m.load_http_cache = lambda: {}
    m.save_http_cache = lambda c: None


def _setup_lib_event(m, crawler, manifest):
    """図書館のイベントクローラ用。_setup_lib に LLM 無効化を足す.

    要約は非決定的なので golden では呼ばない。実データの記事本文は
    FULL_TEXT_THRESHOLD (400 字) を下回るものが多く、その場合は LLM の
    有無に関わらず full 経路なので、解析経路はそのまま走る。
    """
    _setup_lib(m, crawler, manifest)
    m.llm_available = lambda: False


# (golden 名, crawler スクリプト名, setup, seed dir 名 | None)
# seed を渡すと、その中身を out-dir に事前展開してから crawler を走らせる
# (= 既存 YAML がある状態の再現。更新検知 / supersedes の経路を通す)。
CRAWLERS = [
    ("cal-oshirase-fetch", "cal-oshirase-fetch", _setup_oshirase, None),
    ("cal-oshirase-update", "cal-oshirase-fetch", _setup_oshirase, "cal-oshirase-update"),
    ("cal-shicho-blog-fetch", "cal-shicho-blog-fetch", _setup_shicho_blog, None),
    ("cal-tourism-news-fetch", "cal-tourism-news-fetch", _setup_tourism_news, None),
    # 既に本番エントリがある状態で再実行しても重複・移動が起きないことを見る
    # (= has_existing_event の経路)。中止時の【中止】書き換えは非決定的な LLM
    # 応答が要るので golden ではなく test_news_cancel.py が実データで見ている。
    ("cal-tourism-news-existing", "cal-tourism-news-fetch", _setup_tourism_news,
     "cal-tourism-news-existing"),
    # 集合同期型。seed 付きの 3 本は削除ガードの回帰を見る:
    #   update    … 既存 YAML が更新されること
    #   delete    … 取得側に無い「未来」の予定が消えること (golden に無い = 消えた)
    #   keep-past … 取得側に無くても「過去」の予定は残ること
    ("cal-cci-chef-fetch", "cal-cci-chef-fetch", _setup_cci_chef, None),
    ("cal-cci-chef-update", "cal-cci-chef-fetch", _setup_cci_chef, "cal-cci-chef-update"),
    ("cal-cci-chef-delete", "cal-cci-chef-fetch", _setup_cci_chef, "cal-cci-chef-delete"),
    ("cal-cci-chef-keep-past", "cal-cci-chef-fetch", _setup_cci_chef, "cal-cci-chef-keep-past"),
    # 商工会議所の告知 (追記型)。update は既存世代を置いた状態で再実行し、
    # 新 UID + supersedes が付くこと (= 旧世代が残ること) を見る。
    ("cal-cci-event-fetch", "cal-cci-event-fetch", _setup_cci_event, None),
    ("cal-cci-event-update", "cal-cci-event-fetch", _setup_cci_event, "cal-cci-event-update"),
    # 図書館の休館日 (集合同期型)。seed 付きの 4 本が回帰を見る:
    #   update            … 既存 YAML が上書きされること (ダミー hash → 実 hash)
    #   delete            … 取得側に無い「未来かつ範囲内」の休館日が消えること
    #   keep-past         … 取得側に無くても today より前の休館日は残ること
    #   keep-out-of-range … 取得側が返した範囲より後の休館日は、未来でも残ること
    # 削除条件は「incoming に無い かつ 範囲内 かつ today 以降」の 3 つ全部。
    # keep-past に範囲外の日付を使うと、どちらの枝で残ったのか区別できず、
    # 片方が壊れても緑のままになる。だから 2 本に分けて 1 枝ずつ通す。
    # update だけは向きが逆: closing_day に「無い」日付では incoming に入らず
    # 上書き経路を通らないので、closing_day に「ある」日付 (2026-09-07) を使う。
    ("cal-lib-closed-fetch", "cal-lib-closed-fetch", _setup_lib, None),
    ("cal-lib-closed-update", "cal-lib-closed-fetch", _setup_lib, "cal-lib-closed-update"),
    ("cal-lib-closed-delete", "cal-lib-closed-fetch", _setup_lib, "cal-lib-closed-delete"),
    ("cal-lib-closed-keep-past", "cal-lib-closed-fetch", _setup_lib, "cal-lib-closed-keep-past"),
    ("cal-lib-closed-keep-out-of-range", "cal-lib-closed-fetch", _setup_lib,
     "cal-lib-closed-keep-out-of-range"),
    # 図書館のイベント (追記型)。event_day → events.php → 詳細ページの 3 段を
    # 通す。要約は LLM 無効化で full 経路に倒している。
    ("cal-lib-event-fetch", "cal-lib-event-fetch", _setup_lib_event, None),
]


def _run_crawler(crawler, setup, seed):
    m = _load(crawler)
    manifest = _manifest(crawler)
    m.fetch = lambda url: _read_fixture(crawler, manifest[url])
    setup(m, crawler, manifest)
    out = {}
    saved_argv = sys.argv
    try:
        with tempfile.TemporaryDirectory() as d:
            if seed:
                shutil.copytree(os.path.join(SEED, seed), d, dirs_exist_ok=True)
            sys.argv = [crawler, "--out-dir", d]
            if crawler in TODAY_BY_CRAWLER:
                sys.argv += ["--today", TODAY_BY_CRAWLER[crawler]]
            m.main()
            keep = crawler in DETERMINISTIC_DATE_CRAWLERS
            for p in glob.glob(os.path.join(d, "**", "*.yaml"), recursive=True):
                with open(p, encoding="utf-8") as f:
                    out[_golden_key(p, keep_date=keep)] = _normalize(
                        f.read(), keep_dates=keep)
    finally:
        sys.argv = saved_argv
    return out


def main():
    update = "--update" in sys.argv[1:]
    failures = 0
    for name, crawler, setup, seed in CRAWLERS:
        generated = _run_crawler(crawler, setup, seed)
        gdir = os.path.join(GOLD, name)
        if update:
            os.makedirs(gdir, exist_ok=True)
            for old in glob.glob(os.path.join(gdir, "*.yaml")):
                os.remove(old)
            for key, content in generated.items():
                with open(os.path.join(gdir, key), "w", encoding="utf-8") as f:
                    f.write(content)
            print(f"[update] {name}: wrote {len(generated)} golden files")
            continue
        golden_keys = {os.path.basename(p) for p in glob.glob(os.path.join(gdir, "*.yaml"))}
        gen_keys = set(generated)
        crawler_fail = 0
        if golden_keys != gen_keys:
            print(f"FAIL {name}: key set differs")
            print(f"  only in golden:    {sorted(golden_keys - gen_keys)}")
            print(f"  only in generated: {sorted(gen_keys - golden_keys)}")
            crawler_fail += 1
        for key in sorted(gen_keys & golden_keys):
            with open(os.path.join(gdir, key), encoding="utf-8") as f:
                want = f.read()
            if generated[key] != want:
                print(f"FAIL {name}/{key}: content differs")
                crawler_fail += 1
        if crawler_fail == 0:
            print(f"OK {name}: {len(generated)} files match")
        failures += crawler_fail
    if update:
        return 0
    if failures:
        print(f"\n{failures} golden mismatch(es).")
        return 1
    print("\nAll golden checks passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""cal-oshirase-fetch — 飯能市公式サイト「新着情報」RSS を YAML 化。

Source: https://www.city.hanno.lg.jp/cgi-bin/feed.php?siteNew=1&displayCount=50&displayRange=90&includeShortcut=0

RSS 1.0 (RDF) を取得し、各 <item> を 1 終日イベント に変換する。

## 2 つの動作モード

### incremental mode (デフォルト、cron 用)
- UID:     oshirase-<page-id>-<hash6>@hanno.city.tecoli.com
- dtstart: fetched_at (= 取得日、JST)
- 「市の RSS フィードに新着掲載 / または内容が変わった」たびに **別の** YAML を生成。
- 同じ (page_id, content_hash) の YAML が既にあれば skip。
- 過去の YAML は触らず保持 → カレンダー上に「いつ我々が認識したか」「内容変更の履歴」が残る。
- app トップの「今日以降 7 日」ウィンドウに自然に現れる (= 今日 fetched の dtstart=今日)。
- dc:date (市の公開日) は source.publish_date に保持。

### once-per-page mode (legacy、--once-per-page で有効)
- UID:     oshirase-<page-id>@hanno.city.tecoli.com  (page-id は URL 末尾の数字)
- dtstart: dc:date (= 市の公開日)
- 1 page = 1 YAML。既存 UID と同じなら skip、content_hash 差分なら上書き。
- 新規街の onboarding / 過去分 backfill 用。

## description 生成 (両モード共通)

本文長に応じて 3 方式:
- 抽出失敗 (<50字):    URL のみ                    (method=url-only)
- 50-400字:           本文全文 + URL              (method=full)
- >400字:             LLM (Claude Haiku) 要約 + URL (method=llm-haiku-4-5)
                      ※ ANTHROPIC_API_KEY 必須。API 失敗時は full にフォールバック。
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import urllib.request
from datetime import date as _date, datetime, timezone, timedelta

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _lib import (
    USER_AGENT, UID_NAMESPACE, STATUS_MARKERS, fetch, read_yaml_scalar, read_yaml_block,
    strip_status_header, split_description,
    yaml_escape_str, yaml_block_scalar, strip_html, normalize_body,
    strip_markdown, AI_DISCLAIMER_JP,
    output_path_for, find_existing_by_uid, load_source_config,
    load_http_cache, save_http_cache, fetch_with_cache, dtstart_from_last_modified,
)

JST = timezone(timedelta(hours=9))

try:
    import httpx  # LLM 要約用 (>400字 で必要)
except ImportError:
    httpx = None  # type: ignore


# ==================== Source ====================
# 「どこから何を取るか」の city 固有メタ情報は calendar/sources.yaml に外出し済み。
# クローラのコードは都市非依存で、起動時 (import 時) にここで読み込む。
_SRC = load_source_config("oshirase")
DEFAULT_UID_PREFIX = _SRC["uid_prefix"]
SOURCE_TYPE = _SRC["source_type"]
SUMMARY_PREFIX = _SRC["summary_prefix"]
FEED_URL = _SRC["feed_url"]
URL_HOST_ALLOWLIST = _SRC["url_host_allowlist"]


# ==================== Tunables ====================
# 本文長に応じた処理しきい値と format バージョン。
MIN_BODY_CHARS = 50         # これ未満なら抽出失敗扱い → URL のみ
FULL_TEXT_THRESHOLD = 400   # これ以下は全文掲載、超は LLM 要約

# description 整形フォーマットのバージョン. wrapper/disclaimer 変更時にインクリ
# メントすると content_hash が変わり、既存 YAML が再生成される.
# docs/ai-content-policy.md 参照.
# v1: 初版
# v2: AI disclaimer 追加 (LLM要約の冒頭)
# v3: LLM 出力から Markdown 記法を除去 (Google Calendar は plain text 扱い)
# v4: 中止/終了/延期等の最新ステータスを要約冒頭に配置するよう prompt 改訂
# v5: ステータス変更続報 (申込終了等) では要約を短く保つよう prompt 追加
# v6: 主目的判定をタイトル base に変更 (本文の「(終了)」注記に引きずられない)
# v7: 主目的判定を時制 + actionability base に変更
#     (「停止します」future = full detail / 「受付終了」past = brief)
# v8: 対話的応答の禁止を明示 + 一覧/インデックスページの要約方法を追加
#     (報道発表資料一覧で「本文をください」と応答してしまった件の対策)
DESCRIPTION_FORMAT_VERSION = 8


# ==================== LLM ====================
# Claude Haiku 4.5 で本文 (>FULL_TEXT_THRESHOLD 字) を要約する設定。
LLM_MODEL = "claude-haiku-4-5"
LLM_MAX_TOKENS = 1024
LLM_SYSTEM_PROMPT = """あなたは飯能市公式サイトのお知らせ記事を、市民向けカレンダーに掲載するために短く要約するアシスタントです。

これは自動パイプラインの一部で、あなたの出力はそのままカレンダーの予定欄に掲載されます。人間との対話ではありません。読者に質問する・追加情報の提供を求める・要約できない理由を説明する等の対話的応答は絶対にしないでください。どんな入力でも、与えられた本文から作れる最善の要約テキストだけを出力してください。

要約方針:
- 全体で 200〜400 字程度の日本語。
- 日時・期間・場所・対象者・料金・申込締切・申込方法など、市民の行動に関わる事実は省略しない。本文に書かれていないことは書かない (推測禁止)。
- 記事の **主目的を判定** してから要約を組み立ててください。判定軸は「時制 (過去/未来)」と「アクション可能性」:
  - **過去のステータス変更告知** (例: タイトル/本文が「受付終了しました」「中止しました」「定員に達しました」等の事後報告): 要約を **100〜150 字程度に短く** 保ち、ステータス変更 + 対象イベント名 + 過去の日付のみ。日時/場所/対象/料金/講師等の詳細は省略 (既に応募できない情報は冗長)。
  - **未来のステータス変更予告** (例: 「停止します」「中止します」「変更します」等のこれから起きる予告): 通常のイベント告知と同様に、影響期間/対象/代替手段/再開予定など **actionable な情報を含めた完全な要約** を作る (市民は事前に準備や代替行動を検討する必要があるため)。
  - **通常の告知** (タイトルに status 語が無い、開催/案内/募集/資料公開/制度説明等): 主目的の情報を冒頭に。本文中に「(終了)」のような注記があっても、それは背景情報なので末尾近くに簡潔に触れる程度に留める。
  - **一覧・インデックスページ** (本文の大半が個別記事のタイトルや発表日の列挙で、各記事の本文が無い場合): 個別記事の詳細が無いことを理由に要約を放棄しない。「◯◯の一覧ページが更新されました。」のようにページの性格を 1 文で述べた上で、掲載項目を新しい順に「・タイトル（M月D日発表）」の形式で列挙する。列挙は最大 5 件まで。それ以上ある場合は 5 件で打ち切り、最終行に「これより前の発表は元記事をご覧ください。」と添える (件数は数え間違いやすいので書かない)。
  - **どの場合も、本文に明記されたステータス情報は必ず要約に含める**。冒頭か末尾かは上記の主目的判定で決める。市民が誤って「もう参加できない / 日程が変わった」イベントに行こうとしないように注意。
- 日付や金額は本文表記をそのまま (令和8年5月31日 等)。
- 出だしに「お知らせ:」「概要:」のような冗語は不要。本題から始める。
- 末尾に URL や「詳細は〜」を付けない。呼出側で付与する。
- **Markdown 記法 (**太字**、*斜体*、# 見出し、- リスト、`code`、リンク [text](url) 等) は一切使わないでください**。出力先は Google カレンダーの予定欄で、Markdown は literal なテキストとして表示されてしまいます。
- 構造化したい場合は改行と全角記号で表現してください: 箇条書きは行頭「・」、見出しは「【見出し】」、強調が必要な場合は「」または 【 】 を使う。
- 要約だけ返す。前置きや「以下は要約です」等の説明は不要。
"""

# 更新記事の「主な変更」1 行を作る設定。要約より短く、トークンも小さい。
DIFF_LLM_MAX_TOKENS = 256
DIFF_SYSTEM_PROMPT = """あなたは飯能市公式サイトのお知らせ記事が更新されたとき、市民向けカレンダーに「何が変わったか」を 1 行で示すアシスタントです。

これは自動パイプラインの一部で、あなたの出力はそのままカレンダーの予定欄に掲載されます。人間との対話ではありません。読者に質問する・追加情報を求める・作れない理由を説明する等の対話的応答は絶対にしないでください。

入力は 2 つです:
- 「前回の要約」: 前に掲載したときの**要約文**。元記事の全文ではなく、情報が落ちています。
- 「今回の本文」: 今の元記事の本文（全文）。

出力方針:
- 日本語で 1〜2 文、**全体で 120 字以内**。
- 「主な変更:」等のラベルは付けない。変更内容だけを書く。
- **前回の要約は要約であって全文ではありません。** 言い回しの違い、詳しさの違い、書き方の順序の違いは変更として報告しないでください。前回の要約に無い項目を「新設」「追加」と断定してはいけません（単に要約から漏れていただけの可能性があります）。
- 拾うべきは、市民の行動が変わる実質的な変更です: 日付・期間・時刻の変更、金額の変更、件数や区分の変更、申込方法や会場の変更、中止/延期/終了などのステータス変更。
- **変わったことだけを書いてください。** 変わっていない情報（現在の受付期間・場所・対象者など）を「今はこうです」と再掲してはいけません。それは要約本文の役目です。
- **「〜が〜に変更されました」と書いてよいのは、前回の要約に *異なる値* がはっきり書かれている場合だけです。** 前回の要約と今回の本文で同じ値なら、それは変更ではありません。前回の要約に載っていない項目については「変更」と書いてはいけません（単に要約から漏れていただけの可能性があるため）。明らかに新しい項目が加わったと言える場合に限り「〜が追加されました」と書いてよい。
- **変更が複数ある場合は、市民への影響が大きいものから書いてください。** 字数が足りなければ影響の小さいものは切り捨てます。特に「申込の区分・選択肢が増減した」「新しい方式が加わった」類の構造的な変更は、日付の変更より優先して拾ってください。
- **些末な差は省いてください**: 面積や数値の小数点以下の訂正、誤字の修正、言葉遣いの手直しなど、市民の判断が変わらないものは書かない。
- 確信を持って言える変更が無い場合は、**何も出力せず空文字を返してください**（推測で書かない）。
- Markdown 記法 (**太字**、# 見出し、- リスト等) は一切使わない。出力先は Google カレンダーの予定欄で literal 表示されます。
- 変更内容だけを返す。前置きや「以下が変更点です」等の説明は不要。
"""


# ==================== Logic ====================


def safe_url(url: str) -> bool:
    return url.startswith(f"https://{URL_HOST_ALLOWLIST}/")


# ---------- RSS パース ----------


_ITEM_RE = re.compile(r"<item\b[^>]*>([\s\S]*?)</item>", re.IGNORECASE)
_TITLE_RE = re.compile(r"<title>([\s\S]*?)</title>", re.IGNORECASE)
_LINK_RE = re.compile(r"<link>([\s\S]*?)</link>", re.IGNORECASE)
_DATE_RE = re.compile(r"<dc:date>(\d{4})-(\d{2})-(\d{2})T", re.IGNORECASE)
_PAGE_ID_RE = re.compile(r"/(\d+)\.html$")


def parse_items(xml: str) -> list[dict]:
    out: list[dict] = []
    for m in _ITEM_RE.finditer(xml):
        body = m.group(1)
        t = _TITLE_RE.search(body)
        l = _LINK_RE.search(body)
        d = _DATE_RE.search(body)
        if not (t and l and d):
            continue
        title = re.sub(r"\s+", " ", t.group(1)).strip()
        link = l.group(1).strip()
        yyyy, mm, dd = d.group(1), d.group(2), d.group(3)
        try:
            _date(int(yyyy), int(mm), int(dd))
        except ValueError:
            continue
        pid_m = _PAGE_ID_RE.search(link)
        if not pid_m:
            continue
        out.append({
            "title": title,
            "url": link,
            "date": f"{yyyy}-{mm}-{dd}",
            "page_id": pid_m.group(1),
        })
    return out


# ---------- 本文抽出 ----------


def extract_body(html: str) -> str:
    """記事 HTML から本文テキストを抽出.

    `<div id="contents-in">` から `<div class="toiawase">` 直前まで。
    page-number-display ブロックと figure を除外。h2 (head-title) も含めて、
    複数セクション構造 (h2 + wysiwyg の繰り返し) のお知らせに対応。
    """
    m = re.search(r'<div id="contents-in"[^>]*>([\s\S]*?)<!--\s*//#contents-in', html)
    if not m:
        return ""
    block = m.group(1)
    # toiawase (お問い合わせ先) を境界として除去
    block = re.sub(r'<div class="toiawase">[\s\S]*$', "", block)
    # page-id 表示 (本文ではない)
    block = re.sub(r'<div class="page-number-display">[\s\S]*?</div>\s*</div>', "", block)
    # figure / img (本文意味ほぼ無し、altのみ拾うのは複雑なので除外)
    block = re.sub(r"<figure[^>]*>[\s\S]*?</figure>", "", block)
    # h2 は内容を "## " 付きで残す (head-title span 入れ子を一旦テキスト化)
    def _h2_repl(m: re.Match) -> str:
        inner = re.sub(r"<[^>]+>", "", m.group(1))
        inner = re.sub(r"\s+", " ", inner).strip()
        return f"\n\n## {inner}\n\n" if inner else "\n\n"
    block = re.sub(r"<h2[^>]*>([\s\S]*?)</h2>", _h2_repl, block)
    text = strip_html(block)
    return normalize_body(text)


# ---------- LLM 要約 ----------


def summarize_with_llm(title: str, body: str) -> str | None:
    """Claude Haiku 4.5 で要約。失敗時 None を返す (呼出側で fallback)."""
    if httpx is None:
        print("  WARN: httpx not installed, skipping LLM summary", file=sys.stderr)
        return None
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        print("  WARN: ANTHROPIC_API_KEY not set, skipping LLM summary", file=sys.stderr)
        return None
    if not body or len(body) < MIN_BODY_CHARS:
        # 安全装置: 空 body で LLM を呼ばない (ハルシネーション防止)
        return None
    try:
        r = httpx.post(
            "https://api.anthropic.com/v1/messages",
            headers={
                "x-api-key": api_key,
                "anthropic-version": "2023-06-01",
                "content-type": "application/json",
            },
            json={
                "model": LLM_MODEL,
                "max_tokens": LLM_MAX_TOKENS,
                "system": LLM_SYSTEM_PROMPT,
                "messages": [{"role": "user", "content": f"# {title}\n\n{body}"}],
            },
            timeout=60,
        )
        r.raise_for_status()
        data = r.json()
        return strip_markdown(data["content"][0]["text"].strip(), bullet="・")
    except Exception as e:
        print(f"  WARN: LLM summary failed: {e}", file=sys.stderr)
        return None


def diff_with_llm(title: str, prev_summary: str, new_body: str) -> str | None:
    """前回の要約と今回の本文を比較し「主な変更」の本文を返す。失敗/変更なしは None。"""
    if httpx is None:
        return None
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        return None
    if not prev_summary.strip() or not new_body or len(new_body) < MIN_BODY_CHARS:
        # 安全装置: 材料が薄い状態で LLM を呼ばない (ハルシネーション防止)
        return None
    user = (f"# {title}\n\n"
            f"## 前回の要約\n\n{prev_summary}\n\n"
            f"## 今回の本文\n\n{new_body}")
    try:
        r = httpx.post(
            "https://api.anthropic.com/v1/messages",
            headers={
                "x-api-key": api_key,
                "anthropic-version": "2023-06-01",
                "content-type": "application/json",
            },
            json={
                "model": LLM_MODEL,
                "max_tokens": DIFF_LLM_MAX_TOKENS,
                "system": DIFF_SYSTEM_PROMPT,
                "messages": [{"role": "user", "content": user}],
            },
            timeout=60,
        )
        r.raise_for_status()
        data = r.json()
        text = strip_markdown(data["content"][0]["text"].strip(), bullet="・")
        # 改行は status header を壊すので 1 行に畳む
        text = " ".join(text.split())
        return text or None
    except Exception as e:
        print(f"  WARN: LLM diff failed: {e}", file=sys.stderr)
        return None


# ---------- description 組立 ----------


def _llm_available() -> bool:
    """この環境で LLM 呼出が可能か (CI 等で httpx 無 / API key 無 を事前検知)."""
    return httpx is not None and bool(os.environ.get("ANTHROPIC_API_KEY"))


def _diff_line(title: str, prev_path: str, new_body: str) -> str | None:
    """直前世代の YAML と今回の本文から「主な変更」1 行を作る。作れなければ None。

    比較材料は前世代の description (= 前回の LLM 要約)。元記事の本文は保存して
    いないため、旧要約 × 新本文の非対称な比較になる。誤検出の抑制は
    DIFF_SYSTEM_PROMPT 側で行う。
    """
    if not _llm_available():
        return None
    if _read_yaml_scalar(prev_path, "summary_method") == "url-only":
        return None          # 前世代は URL のみ = 比較材料が無い
    raw = read_yaml_block(prev_path, "description")
    if not raw:
        return None
    prev_summary, _url = split_description(strip_status_header(raw))
    if not prev_summary.strip():
        return None
    return diff_with_llm(title, prev_summary, new_body) or None


def _materialize_description(body: str, method: str, title: str, article_url: str,
                              status_header: str = "") -> str:
    """method に応じて description を組み立てる (LLM 呼出はこの中で発生).

    method は事前に環境 (LLM 利用可否) を踏まえて決定される前提のため、
    ここで再 fallback は起きない. LLM 呼出が想定外に失敗した場合は full
    にフォールバックするが、その場合 method 表記と description が乖離する
    点には注意.

    status_header: incremental mode で先頭に置く 1 行 (例: "🆕 新着掲載 (公開日: 2026-04-14)")。
    content_hash には含まれない (status は fetch-time の状態であって本文ではない)。
    """
    header_block = f"{status_header}\n\n" if status_header else ""
    suffix = f"飯能市公式サイト 新着情報: {article_url}"
    if method == "url-only":
        return f"{header_block}{suffix}"
    if method == "full":
        return f"{header_block}{body}\n\n{suffix}"
    if method == "llm-haiku-4-5":
        summary = summarize_with_llm(title, body)
        if summary:
            return f"{header_block}{AI_DISCLAIMER_JP}\n\n{summary}\n\n{suffix}"
        # 例外的失敗 (network/rate limit 等). full にフォールバックして
        # 当該 yaml は次回再評価される (hash は llm-haiku-4-5 で書かれるため、
        # 次回 body 不変でも intended_hash 一致 → skip にならず再試行される設計).
        print(f"  WARN: LLM unexpected failure, fallback to full text: {article_url}", file=sys.stderr)
        return f"{header_block}{body}\n\n{suffix}"
    return f"{header_block}{suffix}"


# ---------- YAML 出力 ----------


def build_yaml_doc(uid: str, item_url: str, page_id: str, title: str, date_str: str,
                   description: str, method: str,
                   content_hash: str, fetched_at: str | None,
                   publish_date: str | None = None,
                   supersedes: str | None = None) -> str:
    lines: list[str] = []
    lines.append(f"uid: {yaml_escape_str(uid)}")
    lines.append(f"summary: {yaml_escape_str(SUMMARY_PREFIX + title)}")
    lines.append(f"url: {yaml_escape_str(item_url)}")
    lines.append(f"dtstart: {yaml_escape_str(date_str)}")
    lines.append(f"dtend: {yaml_escape_str(date_str)}")
    lines.append("description: " + yaml_block_scalar(description, indent=2))
    lines.append("")
    lines.append("render:")
    lines.append("  gcal:")
    lines.append("    mode: single-allday")
    lines.append("")
    lines.append("source:")
    lines.append(f"  type: {SOURCE_TYPE}")
    lines.append(f"  id: {yaml_escape_str(page_id)}")
    lines.append(f"  url: {yaml_escape_str(item_url)}")
    ts = fetched_at or (datetime.utcnow().isoformat() + "Z")
    lines.append(f"  fetched_at: {yaml_escape_str(ts)}")
    lines.append(f"  content_hash: {yaml_escape_str('sha256-' + content_hash)}")
    lines.append(f"  summary_method: {yaml_escape_str(method)}")
    # incremental mode で dtstart を fetched_at に置き換えた場合に、元の公開日 (RSS dc:date)
    # を後追いできるよう保持。once-per-page mode では dtstart == publish_date なので省略。
    if publish_date and publish_date != date_str:
        lines.append(f"  publish_date: {yaml_escape_str(publish_date)}")
    # 同じ page の直前世代 (= この YAML が置き換える内容) の uid。
    # 世代チェーンを辿るための唯一のリンクなので、content_hash には含めない
    # (含めると既存 YAML の hash が動いてカレンダーが氾濫する)。
    if supersedes:
        lines.append(f"  supersedes: {yaml_escape_str(supersedes)}")
    return "\n".join(lines) + "\n"


# ---------- main ----------




def _existing_generations(events_dir: str, uid_prefix: str) -> dict[str, list[tuple[str, str, str, str]]]:
    """既存 YAML を page_id 別に集めた世代索引を返す。

    値は (dtstart, uid, path, content_hash) の list で、dtstart 降順・同 dtstart は
    path 降順に安定ソート済み (先頭 = 直前世代)。content_hash は "sha256-" prefix を
    外した 16 桁。

    incremental mode の skip 判定 (page_id, content_hash) と、更新イベントから
    直前世代を引く supersedes 解決の両方に使う。once-per-page と incremental の
    両形式の UID から page_id を抽出する:
    `oshirase-<pid>@...` / `oshirase-<pid>-<hash6>@...`。
    """
    import glob
    pattern = os.path.join(events_dir, "**", "*.yaml")
    idx: dict[str, list[tuple[str, str, str, str]]] = {}
    pid_re = re.compile(rf"^{re.escape(uid_prefix)}-(\d+)(?:-[A-Za-z0-9]+)?@")
    for path in glob.glob(pattern, recursive=True):
        uid = _read_yaml_scalar(path, "uid")
        if not uid:
            continue
        m = pid_re.match(uid)
        if not m:
            continue
        ch = _read_yaml_scalar(path, "content_hash")
        if not ch:
            continue
        if ch.startswith("sha256-"):
            ch = ch[len("sha256-"):]
        dtstart = _read_yaml_scalar(path, "dtstart") or ""
        idx.setdefault(m.group(1), []).append((dtstart, uid, path, ch))
    for gens in idx.values():
        gens.sort(key=lambda g: (g[0], g[2]), reverse=True)
    return idx


# _read_yaml_scalar は _lib.read_yaml_scalar に移行 (= 重複削除)
_read_yaml_scalar = read_yaml_scalar


def _rewrite_yaml_scalar(path: str, key: str, new_value: str) -> bool:
    """YAML の scalar key (例: content_hash) を in-place 書き換え。

    `--rehash-only` 用の最小限の sed 相当。マッチする最初の行を `\"new_value\"` で
    置換する。インデントと空白は維持。書き換えに成功したら True。
    """
    pat = re.compile(r"^(\s*" + re.escape(key) + r":\s*)\"[^\"]*\"\s*$")
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.readlines()
    except Exception:
        return False
    updated = False
    for i, ln in enumerate(lines):
        m = pat.match(ln)
        if m:
            lines[i] = f"{m.group(1)}{yaml_escape_str(new_value)}\n"
            updated = True
            break
    if not updated:
        return False
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(lines)
        return True
    except Exception:
        return False


def _rewrite_status_header(path: str, new_header: str) -> bool:
    """description ブロック冒頭の status ブロックを new_header で差し替える。

    status ブロックは 🆕/🔄/📝 で始まり最初の空行まで。--backfill-diff 用の
    最小限の in-place 編集で、要約本体・末尾 URL・translations ブロックには
    一切触れない。差し替えたら True。
    """
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.read().split("\n")
    except Exception:
        return False
    head = re.compile(r"^description:\s*\|[-+]?\s*$")
    start = next((i for i, ln in enumerate(lines) if head.match(ln)), None)
    if start is None:
        return False
    i = start + 1
    if i >= len(lines) or not lines[i].startswith("  ") or not lines[i][2:].startswith(STATUS_MARKERS):
        return False
    end = i
    while end < len(lines) and lines[end].strip() != "":
        end += 1
    lines[i:end] = ["  " + ln for ln in new_header.split("\n")]
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write("\n".join(lines))
        return True
    except Exception:
        return False


def _insert_source_field(path: str, after_key: str, key: str, value: str) -> bool:
    """source: ブロックの after_key 行の直後に `key: "value"` を挿入する。

    既に key がある / after_key が無い / 書込失敗 なら False。
    """
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.read().split("\n")
    except Exception:
        return False
    key_re = re.compile(r"^\s*" + re.escape(key) + r":\s")
    if any(key_re.match(ln) for ln in lines):
        return False
    anchor = re.compile(r"^(\s*)" + re.escape(after_key) + r":\s")
    for i, ln in enumerate(lines):
        m = anchor.match(ln)
        if not m:
            continue
        lines.insert(i + 1, f"{m.group(1)}{key}: {yaml_escape_str(value)}")
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write("\n".join(lines))
            return True
        except Exception:
            return False
    return False


def run_backfill_diff(args) -> int:
    """既存の「🔄 内容更新」イベントに、差分行と source.supersedes を後付けする。

    対象は dtstart >= args.since (既定 = 前日 = アプリの表示窓の下限) かつ
    直前世代が存在するもの。記事を再 fetch して旧要約と比較する。
    content_hash / uid / dtstart / ファイル名は変更しない。
    """
    since = args.since or (datetime.now(JST).date() - timedelta(days=1)).isoformat()
    gens = _existing_generations(args.out_dir, args.uid_prefix)
    n = 0
    for page_id in sorted(gens):
        chain = gens[page_id]
        for pos, (dtstart, uid, path, _ch) in enumerate(chain):
            if dtstart < since:
                continue
            if pos + 1 >= len(chain):
                continue                      # 前世代なし = 新着掲載
            desc = read_yaml_block(path, "description") or ""
            if not desc.startswith("🔄"):
                continue                      # 更新イベントではない
            prev_dtstart, prev_uid, prev_path, _ = chain[pos + 1]
            url = _read_yaml_scalar(path, "url")
            if not url or not safe_url(url):
                continue
            try:
                article_html, _etag, _lm = fetch_with_cache(url, None, None)
            except Exception as e:
                print(f"  ERROR fetching {url}: {e}", file=sys.stderr)
                continue
            body = extract_body(article_html or "")
            publish_date = _read_yaml_scalar(path, "publish_date") or dtstart
            title = (_read_yaml_scalar(path, "summary") or "")
            if title.startswith(SUMMARY_PREFIX):
                title = title[len(SUMMARY_PREFIX):]
            header = f"🔄 内容更新 (公開日: {publish_date} / 前回掲載: {prev_dtstart})"
            diff_line = _diff_line(title, prev_path, body)
            if diff_line:
                header = f"{header}\n主な変更: {diff_line}"
            if args.dry_run:
                print(f"# === {path} ===")
                print(header)
                n += 1
                continue
            if not _rewrite_status_header(path, header):
                print(f"  WARN: status header not rewritten: {path}", file=sys.stderr)
                continue
            if not _insert_source_field(path, "publish_date", "supersedes", prev_uid):
                _insert_source_field(path, "summary_method", "supersedes", prev_uid)
            print(f"  BACKFILL {path}", file=sys.stderr)
            n += 1
    print(f"Done [backfill-diff]. files={n}  since={since}", file=sys.stderr)
    return 0


def main() -> None:
    here = os.path.dirname(os.path.abspath(__file__))
    default_out_dir = os.path.join(here, "..", "events")

    ap = argparse.ArgumentParser(description="飯能市公式サイト 新着情報 → YAML")
    ap.add_argument("--out-dir", default=default_out_dir)
    ap.add_argument("--uid-prefix", default=DEFAULT_UID_PREFIX)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--refetch-existing", action="store_true",
                    help="(once-per-page) 既存 YAML も記事 fetch して content_hash 不一致なら上書き")
    ap.add_argument("--once-per-page", action="store_true",
                    help="legacy mode: 1 page = 1 YAML、dtstart = dc:date。"
                         "新規街 onboarding / 過去分 backfill 用。"
                         "デフォルトは incremental mode (新規・内容変化ごとに別 YAML、dtstart=今日)")
    ap.add_argument("--rehash-only", action="store_true",
                    help="migration 用: 既存 YAML の content_hash フィールドだけ現 format_version "
                         "に再計算して in-place 更新。description は触らない (LLM 呼出なし)。"
                         "--once-per-page と組み合わせて使う。")
    ap.add_argument("--backfill-diff", action="store_true",
                    help="既存の『🔄 内容更新』イベントに差分行と source.supersedes を"
                         "後付けする。記事を再 fetch するが content_hash / uid / dtstart は"
                         "変更しない。RSS フィードは見ない。")
    ap.add_argument("--since", default=None,
                    help="--backfill-diff の対象下限 dtstart (YYYY-MM-DD、既定: 前日)")
    ap.add_argument("--min-items", type=int, default=0,
                    help="抽出 item 数がこれ未満なら exit 2 (default: 0)")
    args = ap.parse_args()

    if args.backfill_diff:
        sys.exit(run_backfill_diff(args))

    print(f"Fetching {FEED_URL}", file=sys.stderr)
    xml = fetch(FEED_URL)
    items = parse_items(xml)
    print(f"Parsed {len(items)} items", file=sys.stderr)

    # --refetch-existing は once-per-page mode 専用 (incremental mode では意味を持たない)
    if args.refetch_existing and args.once_per_page:
        items = _augment_with_existing(items, args.out_dir, args.uid_prefix)
        print(f"  with existing YAMLs: {len(items)} items total", file=sys.stderr)

    # incremental mode 用: 既存 YAML を page_id 別の世代索引に pre-scan する。
    # skip 判定用の (page_id, content_hash) と、直前世代 (supersedes / 前回掲載日)
    # の解決を同じ索引から導く。
    existing_gens: dict[str, list[tuple[str, str, str, str]]] = {}
    existing_hashes: set[tuple[str, str]] = set()
    existing_page_ids: set[str] = set()
    if not args.once_per_page:
        existing_gens = _existing_generations(args.out_dir, args.uid_prefix)
        existing_hashes = {(pid, g[3]) for pid, gens in existing_gens.items() for g in gens}
        existing_page_ids = set(existing_gens)

    today_jst = datetime.now(JST).strftime("%Y-%m-%d")
    http_cache = load_http_cache()

    written = 0
    skipped = 0
    unchanged = 0
    for it in items:
        if not safe_url(it["url"]):
            continue

        # once-per-page mode: 既存 UID チェックを記事 fetch 前に行う (polite)
        if args.once_per_page:
            uid = f"{args.uid_prefix}-{it['page_id']}@{UID_NAMESPACE}"
            existing_path = find_existing_by_uid(args.out_dir, uid)
            if existing_path and not args.refetch_existing:
                skipped += 1
                continue
        else:
            uid = None  # incremental: hash 計算後に決定
            existing_path = None

        # 記事取得: 記録済み Last-Modified/ETag で条件付き GET。304 は未更新 → skip。
        entry = http_cache.get(it["url"], {})
        try:
            article_html, etag, lm = fetch_with_cache(
                it["url"], entry.get("etag"), entry.get("last_modified"))
        except Exception as e:
            print(f"  ERROR fetching {it['url']}: {e}", file=sys.stderr)
            continue
        if article_html is None:   # 304 Not Modified
            unchanged += 1
            continue
        http_cache[it["url"]] = {"etag": etag, "last_modified": lm}
        body = extract_body(article_html)
        if not body or len(body) < MIN_BODY_CHARS:
            method = "url-only"
        elif len(body) <= FULL_TEXT_THRESHOLD:
            method = "full"
        elif _llm_available():
            method = "llm-haiku-4-5"
        else:
            # CI 等で LLM 環境が無い場合、長文も full text で書く. method を full
            # にしておけば content_hash も full になり、後でローカルから LLM 付きで
            # 再実行すると method=llm-haiku-4-5 で hash が変わって再生成が走る.
            method = "full"

        # コンテンツ identity の content_hash (= title + date + body のみ)。
        # method / format_version は意図的に含めない (= rendering の選択であって
        # content の identity ではない)。これにより:
        # - LLM 環境変化 (key 失効、httpx 抜け等) で hash が変動して flood しない
        # - format_version bump で全 YAML が "変化あり" 判定されない
        # description の再生成が必要な場合は別途明示的に rehash で対応する。
        canonical = json.dumps(
            {"title": it["title"], "date": it["date"], "body": body},
            ensure_ascii=False, sort_keys=True,
        )
        content_hash = hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:16]

        if args.once_per_page:
            # legacy: 既存 YAML があり content_hash 一致なら skip
            if existing_path:
                old_hash = _read_yaml_scalar(existing_path, "content_hash")
                if old_hash == f"sha256-{content_hash}":
                    unchanged += 1
                    continue
            # --rehash-only: description は再生成せず、既存 YAML の content_hash
            # フィールドだけ in-place で書き換える (LLM 呼出なし)
            if args.rehash_only and existing_path:
                if args.dry_run:
                    print(f"# REHASH {existing_path}: {old_hash} → sha256-{content_hash}")
                    written += 1
                    continue
                _rewrite_yaml_scalar(existing_path, "content_hash",
                                     f"sha256-{content_hash}")
                print(f"  REHASH {existing_path}", file=sys.stderr)
                written += 1
                continue
            dtstart = it["date"]                 # dc:date
            publish_date = None                  # dtstart と同じなので省略
            status_header = ""                   # legacy mode は header 不要
            supersedes = None                    # legacy mode では世代リンクを作らない
        else:
            # incremental: (page_id, content_hash) が既知なら skip (新規 / 変更 のみ書く)
            if (it["page_id"], content_hash) in existing_hashes:
                unchanged += 1
                continue
            uid = f"{args.uid_prefix}-{it['page_id']}-{content_hash[:6]}@{UID_NAMESPACE}"
            dtstart = dtstart_from_last_modified(
                http_cache.get(it["url"], {}).get("last_modified"), today_jst)
            publish_date = it["date"]            # dc:date を保持
            # status: 同 page_id に既存 YAML 無し → 新規 / 既存あり → 内容更新。
            # 更新の場合は直前世代の uid を supersedes に記録し、前回掲載日を header に出す。
            prev = existing_gens.get(it["page_id"], [])
            if prev:
                prev_dtstart, prev_uid, prev_path, _prev_hash = prev[0]
                supersedes = prev_uid
                status_header = f"🔄 内容更新 (公開日: {publish_date} / 前回掲載: {prev_dtstart})"
                diff_line = _diff_line(it["title"], prev_path, body)
                if diff_line:
                    status_header = f"{status_header}\n主な変更: {diff_line}"
            else:
                supersedes = None
                status_header = f"🆕 新着掲載 (公開日: {publish_date})"

        # description を実際に組み立てる (LLM 呼出はここで初めて発生)
        description = _materialize_description(body, method, it["title"], it["url"],
                                              status_header=status_header)
        doc = build_yaml_doc(uid, it["url"], it["page_id"], it["title"], dtstart,
                             description, method, content_hash, None,
                             publish_date=publish_date, supersedes=supersedes)
        out_path = output_path_for(args.out_dir, uid, dtstart)

        if args.dry_run:
            print(f"# === {os.path.relpath(out_path, args.out_dir)} === [method={method}]")
            print(doc)
            continue

        if existing_path and os.path.abspath(existing_path) != os.path.abspath(out_path):
            os.remove(existing_path)
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(doc)
        # incremental では次の loop iter 内でも自身を skip 対象にできるよう索引を更新
        if not args.once_per_page:
            existing_hashes.add((it["page_id"], content_hash))
            existing_page_ids.add(it["page_id"])
            existing_gens.setdefault(it["page_id"], []).insert(
                0, (dtstart, uid, out_path, content_hash))
        verb = "UPDATED" if existing_path else "WROTE"
        print(f"  {verb} [{method}] {out_path}", file=sys.stderr)
        written += 1

    save_http_cache(http_cache)

    mode_label = "once-per-page" if args.once_per_page else "incremental"
    print(f"Done [{mode_label}]. items written={written}  unchanged={unchanged}  skipped (existing)={skipped}",
          file=sys.stderr)

    if (written + skipped) < args.min_items and not args.dry_run:
        print(f"FAIL: items ({written + skipped}) < --min-items ({args.min_items}).",
              file=sys.stderr)
        sys.exit(2)


def _augment_with_existing(items: list[dict], out_dir: str, uid_prefix: str) -> list[dict]:
    """既存 oshirase YAML を items に追加 (RSS の 90 日窓を超えた backfill 用).

    既に items に含まれる page_id は skip。
    """
    import glob
    seen = {it["page_id"] for it in items}
    pattern = os.path.join(out_dir, "**", "*.yaml")
    extra: list[dict] = []
    for path in sorted(glob.glob(pattern, recursive=True)):
        uid = _read_yaml_scalar(path, "uid")
        if not uid or not uid.startswith(f"{uid_prefix}-"):
            continue
        page_id_m = re.match(rf"{re.escape(uid_prefix)}-(\d+)@", uid)
        if not page_id_m:
            continue
        page_id = page_id_m.group(1)
        if page_id in seen:
            continue
        url = _read_yaml_scalar(path, "url")
        date = _read_yaml_scalar(path, "dtstart")
        title_full = _read_yaml_scalar(path, "summary") or ""
        title = title_full[len(SUMMARY_PREFIX):] if title_full.startswith(SUMMARY_PREFIX) else title_full
        if not (url and date and title):
            continue
        extra.append({"title": title, "url": url, "date": date, "page_id": page_id})
        seen.add(page_id)
    return items + extra


if __name__ == "__main__":
    main()
